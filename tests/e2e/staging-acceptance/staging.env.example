# Copy this file outside the repository and fill only with staging values.
# Do not commit the copy. The runner refuses unset credentials and mutable image refs.

# Immutable references only: ghcr.io/<owner>/<name>@sha256:<64 hex>.
VELOX_SERVER_IMAGE=ghcr.io/CHANGE_ME_OWNER/velox-server@sha256:CHANGE_ME_64_HEX_DIGEST
VELOX_WORKER_IMAGE_A=ghcr.io/CHANGE_ME_OWNER/velox-worker@sha256:CHANGE_ME_64_HEX_DIGEST
VELOX_WORKER_IMAGE_B=ghcr.io/CHANGE_ME_OWNER/velox-worker@sha256:CHANGE_ME_64_HEX_DIGEST

# Required admin bearer. Keep this in an ignored file or secret manager.
VELOX_STAGING_ADMIN_TOKEN=CHANGE_ME_RUNTIME_SECRET

# Optional topology overrides.
VELOX_STAGING_PROJECT=velox-staging-acceptance
VELOX_STAGING_WORKDIR=/tmp/velox-staging-acceptance
VELOX_STAGING_REST_PORT=18080
VELOX_STAGING_MASTER_URL=http://127.0.0.1:18080
# Set VELOX_STAGING_ALLOW_REMOTE=1 only for an explicitly approved staging URL.
VELOX_STAGING_ALLOW_REMOTE=0
VELOX_STAGING_GRPC_PORT=19000
VELOX_STAGING_WORKER_A_HEALTH_PORT=18081
VELOX_STAGING_WORKER_B_HEALTH_PORT=18082
VELOX_WORKER_ID_A=worker-e2e-a
VELOX_WORKER_ID_B=worker-e2e-b
VELOX_WORKER_SECRET_A=CHANGE_ME_WORKER_A_SECRET
VELOX_WORKER_SECRET_B=CHANGE_ME_WORKER_B_SECRET
VELOX_WORKER_HEARTBEAT_TIMEOUT=60

# Generated by the runner when absent; no fixture bytes are stored in git.
VELOX_STAGING_FIXTURE_SECONDS=5
