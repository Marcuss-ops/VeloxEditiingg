#!/usr/bin/env bash
# Central operator entry point for the Velox worker fleet.
# Master API operations are authenticated with VELOX_ADMIN_TOKEN; the smoke
# command delegates to the repository's real per-worker certification script.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MASTER_URL="${VELOX_MASTER_URL:-http://127.0.0.1:8000}"
MASTER_URL="${MASTER_URL%/}"

usage() {
    cat <<'EOF'
Usage:
  scripts/fleetctl status [--json]
  scripts/fleetctl inspect <worker_id>
  scripts/fleetctl drain <worker_id> [reason]
  scripts/fleetctl resume <worker_id> [reason]
  scripts/fleetctl quarantine <worker_id> [reason]
  scripts/fleetctl restart <worker_id> [reason]
  scripts/fleetctl update <worker_id> <ghcr-image@sha256:digest> [reason]
  scripts/fleetctl rollback <worker_id> <ghcr-image@sha256:digest> [reason]
  scripts/fleetctl operations [worker_id] [status]
  scripts/fleetctl smoke <worker_id>

Environment:
  VELOX_MASTER_URL   Master base URL (default: http://127.0.0.1:8000)
  VELOX_ADMIN_TOKEN  Admin bearer token
  TOKEN_FILE         File containing VELOX_ADMIN_TOKEN=<value>
  FLEET_INVENTORY     Operator-local Ansible inventory (required for host rollout)
  FLEET_ROLLOUT_PLAYBOOK  Digest rollout playbook override
  FLEET_ROLLOUT_BUNDLE_HASH  Current-commit bundle hash (required for update/rollback)
  FLEET_ROLLOUT_ENGINE_SHA   Current-commit engine SHA-256 (required for update/rollback)
EOF
}

die() { printf 'fleetctl: %s\n' "$*" >&2; exit 2; }

command=${1:-help}
if [[ "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
    usage
    exit 0
fi

resolve_token() {
    if [[ -n "${VELOX_ADMIN_TOKEN:-}" ]]; then
        printf '%s' "$VELOX_ADMIN_TOKEN"
        return
    fi
    if [[ -n "${TOKEN_FILE:-}" && -r "$TOKEN_FILE" ]]; then
        sed -n 's/^VELOX_ADMIN_TOKEN=//p' "$TOKEN_FILE" | head -n 1 \
            | tr -d '\r' | sed "s/^['\"]//; s/['\"]$//"
        return
    fi
    die 'VELOX_ADMIN_TOKEN or TOKEN_FILE is required'
}

TOKEN="$(resolve_token)"
[[ -n "$TOKEN" ]] || die 'admin token is empty'

api() {
    local method=$1 path=$2 body=${3:-}
    local args=(-fsS -X "$method" -H "Authorization: Bearer $TOKEN")
    if [[ -n "$body" ]]; then
        args+=(-H 'Content-Type: application/json' --data-raw "$body")
    fi
    curl "${args[@]}" "$MASTER_URL$path"
}

worker_uri() {
    printf '/api/v1/admin/workers/%s' "$(printf '%s' "$1" | jq -sRr @uri)"
}

require_idle_worker() {
    local id=$1 card
    card=$(api GET "$(worker_uri "$id")")
    jq -e '(.active_jobs // 0) == 0 and ((.health // "") == "DRAINING" or (.status // "") == "DRAINING")' \
        >/dev/null <<<"$card" || die "worker $id must be DRAINING with active_jobs=0 before host rollout"
}

validate_image() {
    [[ "$1" =~ ^ghcr\.io/[a-z0-9._-]+/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]] \
        || die 'image must be a pinned lowercase GHCR @sha256:64 reference'
}

run_digest_rollout() {
    local action=$1 worker_id=$2 image=$3 reason=${4:-fleetctl-$action}
    [[ -n "${FLEET_INVENTORY:-}" ]] \
        || die 'FLEET_INVENTORY is required; use an operator-local inventory file'
    [[ -n "${FLEET_ROLLOUT_BUNDLE_HASH:-}" ]] \
        || die 'FLEET_ROLLOUT_BUNDLE_HASH is required; read it from the current-commit release evidence (worker-image workflow)'
    [[ -n "${FLEET_ROLLOUT_ENGINE_SHA:-}" ]] \
        || die 'FLEET_ROLLOUT_ENGINE_SHA is required; read it from the current-commit release evidence (worker-image workflow)'
    local inventory=$FLEET_INVENTORY
    local playbook=${FLEET_ROLLOUT_PLAYBOOK:-$ROOT/deploy/playbooks/rollout-worker-digest.yml}
    command -v ansible-playbook >/dev/null 2>&1 || die 'ansible-playbook is required for host rollout'
    [[ -r "$inventory" ]] || die "Ansible inventory not readable: $inventory"
    [[ -r "$playbook" ]] || die "rollout playbook not readable: $playbook"
    validate_image "$image"
    require_idle_worker "$worker_id"
    local inventory_host
    inventory_host=$(ansible-inventory -i "$inventory" --list 2>/dev/null \
        | jq -r --arg worker_id "$worker_id" \
            '._meta.hostvars | to_entries[] | select(.value.worker_id == $worker_id) | .key' \
        | head -n 1)
    [[ -n "$inventory_host" && "$inventory_host" != "null" ]] \
        || die "worker_id $worker_id is not mapped to an Ansible inventory host in $inventory"
    printf 'fleetctl: %s worker=%s image=%s reason=%s\n' "$action" "$worker_id" "$image" "$reason" >&2
    ansible-playbook -i "$inventory" "$playbook" --limit "$inventory_host" \
        -e "master_url=$MASTER_URL" \
        -e "velox_master_verify_url=$MASTER_URL" \
        -e "velox_admin_token=$TOKEN" \
        -e "rollout_expected_bundle_hash=$FLEET_ROLLOUT_BUNDLE_HASH" \
        -e "rollout_expected_engine_sha256=$FLEET_ROLLOUT_ENGINE_SHA" \
        -e "target_image=$image" \
        -e "deployment_reason=$reason"
}

case "$command" in
    status)
        if [[ "${2:-}" == "--json" ]]; then
            api GET /api/v1/admin/workers
        else
            rows=$(api GET /api/v1/admin/workers \
                | jq -r '.workers[] | [.worker_id, (.health // .status // "UNKNOWN"), (.software_version // "-"), ((.active_jobs // 0 | tostring)+"/"+(.max_active_jobs // 0 | tostring)), (.last_smoke_status // "-")] | @tsv')
            if command -v column >/dev/null 2>&1; then
                printf '%s\n' "$rows" | column -t -s $'\t'
            else
                printf '%s\n' "$rows"
            fi
        fi
        ;;
    inspect)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        api GET "/api/v1/admin/workers/$(printf '%s' "$worker_id" | jq -sRr @uri)" | jq .
        ;;
    drain|resume|quarantine)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        reason=${3:-fleetctl-$command}
        api POST "/api/v1/admin/workers/$(printf '%s' "$worker_id" | jq -sRr @uri)/$command" \
            "$(jq -cn --arg reason "$reason" '{reason:$reason}')" | jq .
        ;;
    restart)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        reason=${3:-fleetctl-restart}
        api POST /worker/restart \
            "$(jq -cn --arg id "$worker_id" --arg reason "$reason" '{worker_id:$id,reason:$reason}')" | jq .
        ;;
    update|rollback)
        worker_id=${2:-}
        image=${3:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        [[ -n "$image" ]] || die 'pinned image reference is required'
        run_digest_rollout "$command" "$worker_id" "$image" "${4:-fleetctl-$command}"
        ;;
    operations)
        path=/api/v1/admin/operations
        [[ -n "${2:-}" ]] && path+="?worker_id=$(printf '%s' "$2" | jq -sRr @uri)"
        if [[ -n "${3:-}" ]]; then
            separator='?'
            [[ "$path" == *\?* ]] && separator='&'
            path+="${separator}status=$(printf '%s' "$3" | jq -sRr @uri)"
        fi
        api GET "$path" | jq .
        ;;
    smoke)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        VELOX_MASTER_URL="$MASTER_URL" VELOX_ADMIN_TOKEN="$TOKEN" \
            "$ROOT/tests/worker-cert/smoke_one.sh" "$worker_id"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
