#!/usr/bin/env bash
# Central operator entry point for the Velox worker fleet.
#
# Every fleet mutation goes through the canonical Master REST API:
#   fleetctl/API → Master → FleetController → UpdateExecutor →
#   WorkerNodeRegistry → hardened SSH → velox-worker-activate-image
#
# The retired host-rollout bridge is not part of this entry point: update and
# rollback POST the pinned image to /api/v1/admin/workers/{worker_id}/update
# and poll the fleet_operations ledger to terminal state.
#
# Master API operations are authenticated with VELOX_ADMIN_TOKEN; the smoke
# command delegates to the repository's real per-worker certification script.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MASTER_URL="${VELOX_MASTER_URL:-http://127.0.0.1:8000}"
MASTER_URL="${MASTER_URL%/}"

usage() {
    cat <<'EOF'
Usage:
  scripts/fleetctl status [--json]
  scripts/fleetctl inspect <worker_id>
  scripts/fleetctl drain <worker_id> [reason]
  scripts/fleetctl resume <worker_id> [reason]
  scripts/fleetctl quarantine <worker_id> [reason]
  scripts/fleetctl restart <worker_id> [reason]
  scripts/fleetctl update <worker_id> <ghcr-image@sha256:digest> [reason]
  scripts/fleetctl rollback <worker_id> <ghcr-image@sha256:digest> [reason]
  scripts/fleetctl wait-ready <worker_id> [--digest image-or-sha256] [--timeout seconds]
  scripts/fleetctl rollout [--digest image-or-sha256] [--workers all|id1,id2,...] [--serial] [--wait-ready]
  scripts/fleetctl operations [worker_id] [status]
  scripts/fleetctl smoke <worker_id>
  scripts/fleetctl job inspect <job_id> [--json]
  scripts/fleetctl job metrics <job_id>
  scripts/fleetctl job watch <job_id> [--timeout seconds] [--poll seconds] [--json]
  scripts/fleetctl job submit --payload FILE [--workers all|id1,id2,...] [--wait]
  scripts/fleetctl job certify --payload FILE [--workers all|id1,id2,...]
  scripts/fleetctl doctor --production

Environment:
  VELOX_MASTER_URL   Master base URL (default: http://127.0.0.1:8000)
  VELOX_ADMIN_TOKEN  Admin bearer token
  TOKEN_FILE         File containing VELOX_ADMIN_TOKEN=<value>
  FLEETCTL_WAIT_TIMEOUT_SECONDS  poll budget for update/rollback (default: 1800)
  FLEETCTL_WAIT_POLL_SECONDS     poll interval for update/rollback (default: 5)
  FLEETCTL_JOB_TIMEOUT_SECONDS   poll budget for jobs (default: 3600)
  FLEETCTL_JOB_POLL_SECONDS      poll interval for jobs (default: 5)

update/rollback route through the canonical Master API:
  POST /api/v1/admin/workers/{worker_id}/update   {target_digest, reason}
Rollback reuses the same endpoint with the previous-known-good digest: the
Master's UpdateExecutor owns the drain, cosign verification, activation and
the deployment_records audit cascade. There is no separate /rollback route;
POST /update with a known-good digest IS the canonical rollback mechanism.
EOF
}

die() { printf 'fleetctl: %s\n' "$*" >&2; exit 2; }

resolve_go_fleetctl() {
    local candidate="${FLEETCTL_GO_BIN:-$ROOT/DataServer/bin/fleetctl}"
    [[ -x "$candidate" ]] || die "Go fleetctl binary not found: $candidate (set FLEETCTL_GO_BIN or build DataServer/cmd/fleetctl)"
    printf '%s' "$candidate"
}

exec_go_fleetctl() {
    local binary
    binary="$(resolve_go_fleetctl)"
    export VELOX_MASTER_URL="$MASTER_URL"
    # Normalize the legacy TOKEN_FILE format before handing control to Go.
    # The Go client owns HTTP, polling, terminal-state handling and output;
    # this shell boundary only preserves the historical auth inputs.
    if [[ -z "${VELOX_ADMIN_TOKEN:-}" ]]; then
        local resolved_token
        resolved_token="$(resolve_token)"
        export VELOX_ADMIN_TOKEN="$resolved_token"
    fi
    # Put the sub-command first: Go's global flag set stops parsing at the
    # first positional command, while loadClientConfig then consumes the
    # trailing --master flag without stealing command-specific arguments.
    exec "$binary" "$@" --master="$MASTER_URL"
}

command=${1:-help}
if [[ "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
    usage
    exit 0
fi

resolve_token() {
    if [[ -n "${VELOX_ADMIN_TOKEN:-}" ]]; then
        printf '%s' "$VELOX_ADMIN_TOKEN"
        return
    fi
    if [[ -n "${TOKEN_FILE:-}" && -r "$TOKEN_FILE" ]]; then
        sed -n 's/^VELOX_ADMIN_TOKEN=//p' "$TOKEN_FILE" | head -n 1 \
            | tr -d '\r' | sed "s/^['\"]//; s/['\"]$//"
        return
    fi
    die 'VELOX_ADMIN_TOKEN or TOKEN_FILE is required'
}

# Commands already implemented by the typed Go client delegate before
# loading any Bash-only HTTP helpers. Keep this list intentionally small while
# the remaining legacy surfaces migrate in separate, tested commits.
# `status --json` is delegated first because its wire output is already a
# stable machine-readable contract; the human table remains on the legacy
# path until its output compatibility is migrated explicitly.
if [[ "$command" == update || "$command" == rollback || "$command" == operations || "$command" == wait-ready ]]; then
    delegated_args=("$@")
    # The Go client owns typed parsing, HTTP, polling, terminal states and
    # output for these migrated surfaces. Bash only preserves argv/env.
    exec_go_fleetctl "${delegated_args[@]}"
fi
if [[ "$command" == status && "${2:-}" == "--json" ]]; then
    exec_go_fleetctl "$@"
fi
case "$command" in
    inspect|smoke|doctor)
        exec_go_fleetctl "$@"
        ;;
    drain|resume)
        delegated_args=("$@")
        # Preserve the historical positional reason as the Go client's
        # explicit --reason flag. The Go client owns validation/output/polling;
        # this translation is the only compatibility work left in Bash.
        if [[ $# -ge 3 && "$3" != --* ]]; then
            delegated_args=("$1" "$2" --reason "$3")
        fi
        exec_go_fleetctl "${delegated_args[@]}"
        ;;
esac

TOKEN="$(resolve_token)"
[[ -n "$TOKEN" ]] || die 'admin token is empty'

api() {
    local method=$1 path=$2 body=${3:-}
    local args=(-fsS -X "$method" -H "Authorization: Bearer $TOKEN")
    if [[ -n "$body" ]]; then
        args+=(-H 'Content-Type: application/json' --data-raw "$body")
    fi
    curl "${args[@]}" "$MASTER_URL$path"
}

worker_uri() {
    printf '/api/v1/admin/workers/%s' "$(printf '%s' "$1" | jq -sRr @uri)"
}

validate_image() {
    [[ "$1" =~ ^ghcr\.io/[a-z0-9._-]+/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$ ]] \
        || die 'image must be a pinned lowercase GHCR @sha256:64 reference'
}

# post_mutation issues a JSON POST and prints the response body. On non-2xx it
# surfaces the server's JSON error (e.g. 409 "operation already in flight") and
# returns 1 — curl -f would swallow the error body, leaving only a generic
# "HTTP 409" line for the operator.
post_mutation() {
    local path=$1 body=$2 code out msg
    out="$(mktemp)"
    code="$(curl -sS -o "$out" -w '%{http_code}' -X POST \
        -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
        --data-raw "$body" "$MASTER_URL$path" 2>/dev/null || true)"
    if [[ "$code" =~ ^2 ]]; then
        cat "$out"
        rm -f "$out"
        return 0
    fi
    msg="$(jq -r '.error // empty' "$out" 2>/dev/null || true)"
    rm -f "$out"
    printf 'fleetctl: POST %s failed (HTTP %s): %s\n' "$path" "$code" "$msg" >&2
    return 1
}

# post_update_mutation is the update-only POST surface. A 409 is actionable
# when the Master returns an existing operation_id: poll that operation rather
# than losing the correlation behind a generic HTTP error. Other mutation
# commands retain post_mutation's existing behavior.
post_update_mutation() {
    local path=$1 body=$2 code out msg operation_id
    out="$(mktemp)"
    code="$(curl -sS -o "$out" -w '%{http_code}' -X POST \
        -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json' \
        --data-raw "$body" "$MASTER_URL$path" 2>/dev/null || true)"
    if [[ "$code" =~ ^2 ]]; then
        cat "$out"
        rm -f "$out"
        return 0
    fi
    if [[ "$code" == "409" ]]; then
        operation_id="$(jq -r '.operation_id // empty' "$out" 2>/dev/null || true)"
        if [[ -n "$operation_id" ]]; then
            cat "$out"
            rm -f "$out"
            return 0
        fi
    fi
    msg="$(jq -r '.error // .detail // empty' "$out" 2>/dev/null || true)"
    rm -f "$out"
    printf 'fleetctl: POST %s failed (HTTP %s): %s\n' "$path" "$code" "$msg" >&2
    return 1
}

# run_digest_update POSTs the pinned image to the canonical Master update API
# and blocks on the fleet_operations ledger until the cascade is terminal.
# The same endpoint serves both `update` (a new target digest) and `rollback`
# (the previous-known-good digest): the Master's UpdateExecutor runs the full
# forward pipeline (drain → cosign → pull → velox-worker-activate-image →
# health → smoke → Drive) and records the audit rows in deployment_records.
run_digest_update() {
    local action=$1 worker_id=$2 image=$3
    local reason=${4:-fleetctl-$action}
    local path body response op_id
    validate_image "$image"
    path="$(worker_uri "$worker_id")/update"
    body="$(jq -cn --arg target "$image" --arg reason "$reason" '{target_digest:$target, reason:$reason}')"
    printf 'fleetctl: %s worker=%s image=%s reason=%s\n' "$action" "$worker_id" "$image" "$reason" >&2
    response="$(post_update_mutation "$path" "$body")"
    op_id="$(jq -r '.operation_id // empty' <<<"$response")"
    [[ -n "$op_id" ]] || die "update API returned no operation_id: $response"
    printf 'fleetctl: %s queued operation_id=%s\n' "$action" "$op_id" >&2
    poll_operation "$op_id"
}

# normalize_update_image preserves the historical full-image positional form
# while accepting the canonical caller form --digest sha256:<64-hex>. The API
# requires the complete GHCR reference, so bare digests use the configured
# worker repository (or the production default) before validation and POST.
normalize_update_image() {
    local image=$1 repository
    [[ -n "$image" ]] || die 'pinned image reference is required (use --digest)'
    if [[ "$image" =~ ^sha256:[a-f0-9]{64}$ ]]; then
        repository="${GHCR_WORKER_REPOSITORY:-ghcr.io/marcuss-ops/velox-worker}"
        repository="${repository%/}"
        [[ "$repository" =~ ^ghcr\.io/[a-z0-9._-]+/[a-z0-9._/-]+$ ]] \
            || die 'GHCR_WORKER_REPOSITORY must be a valid lowercase ghcr.io repository'
        printf '%s@%s' "$repository" "$image"
    else
        printf '%s' "$image"
    fi
}

parse_update_args() {
    local action=$1
    shift
    local worker_id='' image='' reason='' arg
    while [[ $# -gt 0 ]]; do
        arg=$1
        case "$arg" in
            --digest=*)
                [[ -z "$image" ]] || die 'update digest specified more than once'
                image=${arg#*=}
                shift
                ;;
            --digest)
                [[ $# -ge 2 ]] || die '--digest requires a value'
                [[ -z "$image" ]] || die 'update digest specified more than once'
                image=$2
                shift 2
                ;;
            --reason=*)
                [[ -z "$reason" ]] || die 'update reason specified more than once'
                reason=${arg#*=}
                shift
                ;;
            --reason)
                [[ $# -ge 2 ]] || die '--reason requires a value'
                [[ -z "$reason" ]] || die 'update reason specified more than once'
                reason=$2
                shift 2
                ;;
            -*)
                die "unknown update option: $arg"
                ;;
            *)
                if [[ -z "$worker_id" ]]; then
                    worker_id=$arg
                elif [[ -z "$image" ]]; then
                    image=$arg
                elif [[ -z "$reason" ]]; then
                    reason=$arg
                else
                    die "unexpected update argument: $arg"
                fi
                shift
                ;;
        esac
    done
    [[ -n "$worker_id" ]] || die 'worker_id is required'
    image="$(normalize_update_image "$image")"
    reason=${reason:-fleetctl-$action}
    run_digest_update "$action" "$worker_id" "$image" "$reason"
}

# poll_operation blocks until the fleet_operations ledger row is terminal.
# SUCCEEDED → exit 0; FAILED / ROLLBACK → exit 1 with the audit message;
# budget exhaustion → exit 1 (operator can re-poll via `fleetctl operations`).
poll_operation() {
    local op_id=$1
    local timeout=${FLEETCTL_WAIT_TIMEOUT_SECONDS:-1800}
    local poll=${FLEETCTL_WAIT_POLL_SECONDS:-5}
    local deadline=$(( $(date +%s) + timeout ))
    local op_uri status card msg
    op_uri="/api/v1/admin/operations/$(printf '%s' "$op_id" | jq -sRr @uri)"
    while :; do
        card="$(api GET "$op_uri")"
        status="$(jq -r '.status // "UNKNOWN"' <<<"$card")"
        case "$status" in
            SUCCEEDED)
                printf 'fleetctl: operation %s SUCCEEDED\n' "$op_id" >&2
                return 0
                ;;
            FAILED|ROLLBACK)
                msg="$(jq -r '.error_message // ""' <<<"$card")"
                printf 'fleetctl: operation %s ended %s: %s\n' "$op_id" "$status" "$msg" >&2
                return 1
                ;;
        esac
        if (( $(date +%s) >= deadline )); then
            printf 'fleetctl: timed out waiting for operation %s (last status: %s)\n' "$op_id" "$status" >&2
            return 1
        fi
        sleep "$poll"
    done
}

# wait_ready is the one readiness gate used by rollout and by operators. It
# reads the canonical worker projection; it never reaches a worker over SSH.
wait_ready() {
    local worker_id=$1 expected_image=${2:-} timeout=${3:-${FLEETCTL_READY_TIMEOUT_SECONDS:-180}} poll=${4:-${FLEETCTL_READY_POLL_SECONDS:-5}}
    local deadline=$(( $(date +%s) + timeout )) card ready connection health actual_digest expected_digest
    [[ -n "$worker_id" ]] || die 'worker_id is required'
    if [[ -n "$expected_image" ]]; then
        expected_digest="${expected_image##*@}"
        [[ "$expected_digest" =~ ^sha256:[a-f0-9]{64}$ ]] || die 'readiness digest must be a pinned image or sha256 digest'
        expected_digest="${expected_digest#sha256:}"
    fi
    while :; do
        card="$(api GET "$(worker_uri "$worker_id")")"
        ready="$(jq -r '.readiness.status // "UNKNOWN"' <<<"$card")"
        connection="$(jq -r '.connection_state // .status // "UNKNOWN"' <<<"$card")"
        health="$(jq -r '.health // "UNKNOWN"' <<<"$card")"
        actual_digest="$(jq -r '.image_digest // .digest // ""' <<<"$card")"
        actual_digest="${actual_digest#sha256:}"
        printf 'fleetctl: worker=%s connection=%s health=%s readiness=%s digest=%s\n' \
            "$worker_id" "$connection" "$health" "$ready" "${actual_digest:--}" >&2
        if [[ "$ready" == "ok" && "$connection" == "CONNECTED" && "$health" == "HEALTHY" ]]; then
            if [[ -z "$expected_digest" || "$actual_digest" == *"$expected_digest"* ]]; then
                printf 'fleetctl: worker=%s READY\n' "$worker_id" >&2
                return 0
            fi
        fi
        if (( $(date +%s) >= deadline )); then
            printf 'fleetctl: worker=%s did not become READY (connection=%s health=%s readiness=%s digest=%s expected=%s)\n' \
                "$worker_id" "$connection" "$health" "$ready" "${actual_digest:--}" "${expected_digest:--}" >&2
            return 1
        fi
        sleep "$poll"
    done
}

resolve_worker_ids() {
    local selection=${1:-all} worker_id
    if [[ "$selection" == "all" ]]; then
        api GET /api/v1/admin/workers | jq -er '.workers[] | .worker_id'
        return
    fi
    IFS=',' read -r -a selected_workers <<<"$selection"
    for worker_id in "${selected_workers[@]}"; do
        [[ -n "$worker_id" ]] || die 'worker selection contains an empty worker_id'
        printf '%s\n' "$worker_id"
    done
}

parse_wait_ready_args() {
    local worker_id='' image='' timeout=${FLEETCTL_READY_TIMEOUT_SECONDS:-180} poll=${FLEETCTL_READY_POLL_SECONDS:-5} arg
    while [[ $# -gt 0 ]]; do
        arg=$1
        case "$arg" in
            --digest=*) image=${arg#*=}; shift ;;
            --digest) [[ $# -ge 2 ]] || die '--digest requires a value'; image=$2; shift 2 ;;
            --timeout=*) timeout=${arg#*=}; shift ;;
            --timeout) [[ $# -ge 2 ]] || die '--timeout requires a value'; timeout=$2; shift 2 ;;
            --poll=*) poll=${arg#*=}; shift ;;
            --poll) [[ $# -ge 2 ]] || die '--poll requires a value'; poll=$2; shift 2 ;;
            -*) die "unknown wait-ready option: $arg" ;;
            *) [[ -z "$worker_id" ]] || die "unexpected wait-ready argument: $arg"; worker_id=$arg; shift ;;
        esac
    done
    [[ -n "$worker_id" ]] || die 'worker_id is required'
    if [[ -n "$image" ]]; then image="$(normalize_update_image "$image")"; fi
    wait_ready "$worker_id" "$image" "$timeout" "$poll"
}

rollout() {
    local image='' selection=all reason=fleetctl-rollout wait_for_ready=0 arg worker_id
    while [[ $# -gt 0 ]]; do
        arg=$1
        case "$arg" in
            --digest=*) image=${arg#*=}; shift ;;
            --digest) [[ $# -ge 2 ]] || die '--digest requires a value'; image=$2; shift 2 ;;
            --workers=*) selection=${arg#*=}; shift ;;
            --workers) [[ $# -ge 2 ]] || die '--workers requires all or a comma-separated worker_id list'; selection=$2; shift 2 ;;
            --reason=*) reason=${arg#*=}; shift ;;
            --reason) [[ $# -ge 2 ]] || die '--reason requires a value'; reason=$2; shift 2 ;;
            --serial) shift ;;
            --wait-ready) wait_for_ready=1; shift ;;
            --parallel) die 'rollout is serial-only; omit --parallel and use --serial'
                ;;
            -*) die "unknown rollout option: $arg" ;;
            *) [[ -z "$image" ]] || die "unexpected rollout argument: $arg"; image=$arg; shift ;;
        esac
    done
    image="$(normalize_update_image "$image")"
    mapfile -t workers < <(resolve_worker_ids "$selection")
    ((${#workers[@]} > 0)) || die 'no workers selected'
    printf 'fleetctl: rolling out %s to %d worker(s) serially\n' "$image" "${#workers[@]}" >&2
    for worker_id in "${workers[@]}"; do
        run_digest_update update "$worker_id" "$image" "$reason"
        if (( wait_for_ready )); then
            wait_ready "$worker_id" "$image"
        fi
    done
}

m2m_api() {
    local token=$1 method=$2 path=$3 body=${4:-}
    local args=(-fsS -X "$method" -H "Authorization: Bearer $token")
    if [[ -n "$body" ]]; then
        args+=(-H 'Content-Type: application/json' --data-raw "$body")
    fi
    curl "${args[@]}" "$MASTER_URL$path"
}

M2M_CLIENT_ID=''
M2M_TOKEN=''
cleanup_m2m() {
    if [[ -n "$M2M_CLIENT_ID" ]]; then
        api DELETE "/api/v1/admin/m2m/keys/$(printf '%s' "$M2M_CLIENT_ID" | jq -sRr @uri)" >/dev/null 2>&1 || true
        M2M_CLIENT_ID=''
        M2M_TOKEN=''
    fi
}

issue_m2m() {
    M2M_CLIENT_ID="fleetctl-job-$(date +%s)-$$"
    local response body
    body="$(jq -cn --arg client_id "$M2M_CLIENT_ID" '{client_id:$client_id, description:"fleetctl ephemeral job operator", scopes:["jobs.submit"]}')"
    response="$(api POST /api/v1/admin/m2m/keys "$body")"
    M2M_TOKEN="$(jq -er '.plaintext_secret' <<<"$response")" || die 'M2M issue response did not contain plaintext_secret'
    trap cleanup_m2m EXIT
}

wait_job() {
    local job_id=$1 token=$2 timeout=${3:-${FLEETCTL_JOB_TIMEOUT_SECONDS:-3600}} poll=${4:-${FLEETCTL_JOB_POLL_SECONDS:-5}}
    local deadline=$(( $(date +%s) + timeout )) snapshot status
    while :; do
        snapshot="$(m2m_api "$token" GET "/api/v1/jobs/$(printf '%s' "$job_id" | jq -sRr @uri)")"
        status="$(jq -r '.status // .state // "UNKNOWN"' <<<"$snapshot" | tr '[:lower:]' '[:upper:]')"
        printf 'fleetctl: job=%s status=%s\n' "$job_id" "$status" >&2
        case "$status" in
            SUCCEEDED|FAILED|CANCELLED|COMPLETED) [[ "$status" == "SUCCEEDED" || "$status" == "COMPLETED" ]] ; return $? ;;
        esac
        if (( $(date +%s) >= deadline )); then
            printf 'fleetctl: timed out waiting for job=%s (last status=%s)\n' "$job_id" "$status" >&2
            return 1
        fi
        sleep "$poll"
    done
}

print_job_card() {
    local job_id=$1 snapshot=$2
    jq -r --arg job_id "$job_id" '
      . as $root |
      (($root.execution.attempts // []) | if length > 0 then .[-1] else {} end) as $a |
      [
        ("job:        " + $job_id),
        ("status:     " + (($root.job.status // "UNKNOWN")|tostring)),
        ("attempt:    " + (($a.attempt_id // "-")|tostring)),
        ("worker:     " + (($a.worker_name // $a.worker_id // "-")|tostring)),
        ("worker_id:  " + (($a.worker_id // "-")|tostring)),
        ("phase:      " + (($a.phase // "-")|tostring)),
        ("progress:   " + (if $a.current_scene != null then (($a.current_scene|tostring) + "/" + (($a.total_scenes // "?")|tostring) + " scenes, " + (($a.current_segment // "?")|tostring) + "/" + (($a.total_segments // "?")|tostring) + " segments") else "-" end)),
        ("error_code: " + (($a.error_code // "-")|tostring)),
        ("error:      " + (($a.error_message // "-")|tostring)),
        ("ffmpeg:     " + (if $a.ffmpeg_speed_x != null then ($a.ffmpeg_speed_x|tostring) + "x" else "-" end))
      ] | .[]
    ' <<<"$snapshot"
}

print_job_summary() {
    local job_id=$1 snapshot=$2
    jq -r --arg job_id "$job_id" '
      def ms($v): if ($v // 0) == 0 then "0 ms" else (($v|tostring) + " ms") end;
      def sec($v): (((($v // 0) / 1000) * 100) | round / 100 | tostring) + " s";
      def bytes($v): (($v // 0)|tostring) + " B";
      . as $root |
      (($root.execution.attempts // []) | if length > 0 then .[-1] else {} end) as $a |
      ($a.metrics // {}) as $m |
      ($root.execution.cache // {}) as $cache |
      [
        "job:        " + $job_id,
        "status:     " + (($root.job.status // "UNKNOWN")|tostring),
        "attempt:    " + (($a.attempt_id // "-")|tostring),
        "worker:     " + (($a.worker_name // $a.worker_id // "-")|tostring),
        "worker_id:  " + (($a.worker_id // "-")|tostring),
        "phase:      " + (($a.phase // "-")|tostring),
        "progress:   " + (if $a.current_scene != null then (($a.current_scene|tostring) + "/" + (($a.total_scenes // "?")|tostring) + " scenes, " + (($a.current_segment // "?")|tostring) + "/" + (($a.total_segments // "?")|tostring) + " segments") else "-" end),
        "wall:       " + sec($root.execution.total_wall_time_ms),
        "",
        "ASSETS",
        "cache hits: " + (($cache.hits // $a.cache_stats.cache_hits // 0)|tostring),
        "cache miss: " + (($cache.misses // $a.cache_stats.cache_misses // 0)|tostring),
        "network RX: " + bytes($m.network_rx_bytes),
        "network TX: " + bytes($m.network_tx_bytes),
        "download:   " + ms($m.engine_asset_download_ms),
        "",
        "RENDER",
        "mode:       " + (($m.concat_mode // "-")|tostring),
        "segments:   " + (($m.segment_count // (($root.execution.segments // [])|length) // 0)|tostring),
        "copy/build: " + ms($m.engine_segment_build_ms),
        "encode:     " + (if (($m.encode_passes // 0) == 0) then "0 ms" else ms($a.phase_breakdown.encode) end),
        "decoded:    " + (($m.frames_decoded // $a.frames_decoded // 0)|tostring),
        "encoded:    " + (($m.frames_encoded // $a.frames_encoded // 0)|tostring),
        "composited: " + (($m.frames_composited // $a.frames_composited // 0)|tostring),
        "",
        "PHASES",
        (($a.phase_breakdown // {}) | to_entries | sort_by(.key) | .[] | ("\(.key):       " + (.value|tostring) + " ms")),
        "",
        "RESOURCES",
        "cpu time:   " + ms($m.cpu_time_ms),
        "cpu peak:   " + (($m.cpu_percent_peak // 0)|tostring) + "%",
        "rss peak:   " + bytes($m.rss_peak_bytes),
        "disk read:  " + bytes($m.disk_read_bytes),
        "disk write: " + bytes($m.disk_write_bytes),
        "",
        "AUDIO / ARTIFACT",
        "audio total: " + ms($a.phase_breakdown.audio),
        "mix + AAC:  " + ms($a.phase_breakdown.audio_encode),
        "audio dl:   " + ms($m.engine_audio_download_ms),
        "audio mux:  " + ms($m.engine_mux_audio_ms),
        "ffprobe:    " + (($m.ffprobe_valid // "-")|tostring),
        "artifact:   " + bytes($m.output_file_size),
        "sha256:     " + (($m.output_sha256 // "-")|tostring),
        "",
        "DELIVERY",
        (($root.deliveries // [])[] |
          ("delivery " + (.delivery_id // "-") + ": " + (.status // "UNKNOWN") +
           " queue=" + ms(.queue_ms) + " upload=" + ms(.upload_ms) + " total=" + ms(.total_ms) +
           (if (.remote_url // "") != "" then " link=" + .remote_url else "" end))),
        "",
        "ASSET TIMINGS",
        (($root.execution.segments // [])[] |
          ("segment " + (.segment_index|tostring) +
           " scene=" + (.scene_id // "-") +
           " role=" + (.source_type // "-") +
           " asset=" + (.asset_key // "-") +
           " download=" + ms(.asset_download_ms) +
           " source=" + bytes(.source_bytes) +
           " output=" + bytes(.output_bytes) +
           " status=" + (.status // "-")))
      ] | .[] | select(. != null)
    ' <<<"$snapshot"
}

job_submit() {
    local payload_file='' selection=all wait_for_jobs=0 idem_prefix='' arg
    idem_prefix="fleetctl-$(date +%s)"
    while [[ $# -gt 0 ]]; do
        arg=$1
        case "$arg" in
            --payload=*) payload_file=${arg#*=}; shift ;;
            --payload) [[ $# -ge 2 ]] || die '--payload requires a file'; payload_file=$2; shift 2 ;;
            --workers=*) selection=${arg#*=}; shift ;;
            --workers) [[ $# -ge 2 ]] || die '--workers requires all or a comma-separated worker_id list'; selection=$2; shift 2 ;;
            --idempotency-prefix=*) idem_prefix=${arg#*=}; shift ;;
            --idempotency-prefix) [[ $# -ge 2 ]] || die '--idempotency-prefix requires a value'; idem_prefix=$2; shift 2 ;;
            --wait) wait_for_jobs=1; shift ;;
            -*) die "unknown job submit option: $arg" ;;
            *) die "unexpected job submit argument: $arg" ;;
        esac
    done
    [[ -n "$payload_file" && -r "$payload_file" ]] || die 'job payload file is required and must be readable'
    jq -e 'type == "object"' "$payload_file" >/dev/null || die 'job payload must be a JSON object'
    mapfile -t workers < <(resolve_worker_ids "$selection")
    ((${#workers[@]} > 0)) || die 'no workers selected'
    issue_m2m
    declare -a job_ids=()
    declare -a job_workers=()
    local worker_id body response job_id key
    for worker_id in "${workers[@]}"; do
        key="${idem_prefix}-${worker_id}-$(date +%s%N)"
        body="$(jq --arg key "$key" --arg worker "$worker_id" '.idempotency_key=$key | .placement_pin_worker_id=$worker' "$payload_file")"
        response="$(m2m_api "$M2M_TOKEN" POST /api/v1/jobs "$body")"
        job_id="$(jq -er '.job_id // .id // empty' <<<"$response")" || die "job submit returned no job_id for worker=$worker_id"
        job_ids+=("$job_id")
        job_workers+=("$worker_id")
        printf 'fleetctl: submitted job=%s worker=%s\n' "$job_id" "$worker_id"
    done
    if (( wait_for_jobs )); then
        local overall=0 i
        for i in "${!job_ids[@]}"; do
            wait_job "${job_ids[$i]}" "$M2M_TOKEN" || overall=1
            snapshot="$(api GET "/api/v1/admin/jobs/$(printf '%s' "${job_ids[$i]}" | jq -sRr @uri)")"
            print_job_card "${job_ids[$i]}" "$snapshot"
        done
        return "$overall"
    fi
    printf '%s\n' "${job_ids[@]}"
}

case "$command" in
    status)
        if [[ "${2:-}" == "--json" ]]; then
            api GET /api/v1/admin/workers
        else
            rows=$(api GET /api/v1/admin/workers \
                | jq -r '.workers[] | [(.worker_name // .hostname // .worker_id), .worker_id, (.health // .status // "UNKNOWN"), (.software_version // "-"), ((.active_jobs // 0 | tostring)+"/"+(.max_active_jobs // 0 | tostring)), (.last_smoke_status // "-")] | @tsv')
            header=$'NAME\tWORKER_ID\tHEALTH\tVERSION\tJOBS\tLAST_SMOKE'
            if command -v column >/dev/null 2>&1; then
                { printf '%s\n' "$header"; printf '%s\n' "$rows"; } | column -t -s $'\t'
            else
                { printf '%s\n' "$header"; printf '%s\n' "$rows"; }
            fi
        fi
        ;;
    inspect)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        api GET "$(worker_uri "$worker_id")" | jq .
        ;;
    drain|resume|quarantine)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        reason=${3:-fleetctl-$command}
        api POST "$(worker_uri "$worker_id")/$command" \
            "$(jq -cn --arg reason "$reason" '{reason:$reason}')" | jq .
        ;;
    restart)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        reason=${3:-fleetctl-restart}
        api POST "$(worker_uri "$worker_id")/restart" \
            "$(jq -cn --arg reason "$reason" '{reason:$reason}')" | jq .
        ;;
    update|rollback)
        shift
        parse_update_args "$command" "$@"
        ;;
    rollout)
        shift
        rollout "$@"
        ;;
    smoke)
        worker_id=${2:-}
        [[ -n "$worker_id" ]] || die 'worker_id is required'
        VELOX_MASTER_URL="$MASTER_URL" VELOX_ADMIN_TOKEN="$TOKEN" \
            "$ROOT/tests/worker-cert/smoke_one.sh" "$worker_id"
        ;;
    job)
        job_command=${2:-}
        job_id=${3:-}
        [[ -n "$job_command" ]] || die 'job requires inspect, metrics, watch, submit, or certify'
        if [[ "$job_command" == "submit" || "$job_command" == "certify" ]]; then
            shift 2
            if [[ "$job_command" == "certify" ]]; then
                job_submit --wait "$@"
            else
                job_submit "$@"
            fi
            exit $?
        fi
        [[ -n "$job_id" ]] || die 'job inspect, metrics, and watch require a job_id'
        job_path="/api/v1/admin/jobs/$(printf '%s' "$job_id" | jq -sRr @uri)"
        case "$job_command" in
            inspect)
                shift 3
                inspect_json=0
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) inspect_json=1; shift ;;
                        *) die "unknown job inspect option: $1" ;;
                    esac
                done
                snapshot=$(api GET "$job_path")
                if (( inspect_json )); then
                    printf '%s\n' "$snapshot" | jq .
                else
                    print_job_summary "$job_id" "$snapshot"
                fi
                ;;
            metrics)
                api GET "$job_path/metrics" | jq .
                ;;
            watch)
                shift 3
                watch_timeout=${FLEETCTL_JOB_TIMEOUT_SECONDS:-3600}
                watch_poll=${FLEETCTL_JOB_POLL_SECONDS:-5}
                watch_json=0
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --timeout=*) watch_timeout=${1#*=}; shift ;;
                        --timeout) [[ $# -ge 2 ]] || die '--timeout requires a value'; watch_timeout=$2; shift 2 ;;
                        --poll=*) watch_poll=${1#*=}; shift ;;
                        --poll) [[ $# -ge 2 ]] || die '--poll requires a value'; watch_poll=$2; shift 2 ;;
                        --json) watch_json=1; shift ;;
                        *) die "unknown job watch option: $1" ;;
                    esac
                done
                watch_deadline=$(( $(date +%s) + watch_timeout ))
                last_watch_signature=''
                while :; do
                    snapshot=$(api GET "$job_path")
                    if (( watch_json )); then
                        printf '%s\n' "$snapshot"
                    else
                        watch_signature=$(jq -r '[(.job.status // "UNKNOWN"), (.execution.attempts[-1].phase // ""), (.execution.attempts[-1].current_scene // 0), (.execution.attempts[-1].current_segment // 0), (.execution.attempts[-1].error_code // "")] | @tsv' <<<"$snapshot")
                        if [[ "$watch_signature" != "$last_watch_signature" ]]; then
                            print_job_card "$job_id" "$snapshot"
                            printf '\n'
                            last_watch_signature=$watch_signature
                        fi
                    fi
                    terminal=$(jq -r '.job.status // ""' <<<"$snapshot" | tr '[:lower:]' '[:upper:]')
                    case "$terminal" in
                        SUCCEEDED|FAILED|CANCELLED|COMPLETED)
                            [[ "$terminal" == "SUCCEEDED" || "$terminal" == "COMPLETED" ]]
                            break
                            ;;
                    esac
                    if (( $(date +%s) >= watch_deadline )); then
                        die "timed out waiting for job $job_id (last status: $terminal)"
                    fi
                    sleep "$watch_poll"
                done
                ;;
            *)
                die "unknown job command: $job_command"
                ;;
        esac
        ;;
    doctor)
        [[ "${2:-}" == "--production" ]] || die 'doctor requires --production'
        api GET /api/v1/admin/doctor/production | jq .
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
