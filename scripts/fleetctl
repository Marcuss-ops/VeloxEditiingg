#!/usr/bin/env bash
# Thin fleetctl launcher.
#
# The Go client owns HTTP, authentication, typed argument parsing, operation
# polling, terminal states and output for migrated commands. The compatibility
# bridge remains available for commands not yet implemented by Go.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MASTER_URL="${VELOX_MASTER_URL:-http://127.0.0.1:8000}"
MASTER_URL="${MASTER_URL%/}"
LEGACY="${FLEETCTL_LEGACY_BIN:-$ROOT/scripts/fleetctl-legacy}"

usage() {
    cat <<'EOF'
Usage:
  scripts/fleetctl status [--json]
  scripts/fleetctl inspect <worker_id>
  scripts/fleetctl drain <worker_id> [reason]
  scripts/fleetctl resume <worker_id> [reason]
  scripts/fleetctl update <worker_id> <ghcr-image@sha256:digest> [reason]
  scripts/fleetctl rollback <worker_id> <ghcr-image@sha256:digest> [reason]
  scripts/fleetctl operations [worker_id] [status]
  scripts/fleetctl wait-ready <worker_id> [--digest image-or-sha256] [--timeout seconds] [--poll seconds]
  scripts/fleetctl rollout [--digest image-or-sha256] [--workers all|id1,id2,...] [--reason R] [--wait-ready]
  scripts/fleetctl job inspect <job_id> [--json]
  scripts/fleetctl job metrics <job_id>
  scripts/fleetctl job watch <job_id> [--timeout seconds] [--poll seconds] [--json]

Commands not yet implemented by the Go client (quarantine, restart,
job submit/certify) are forwarded to the compatibility bridge:
  scripts/fleetctl-legacy <command> ...

Environment:
  VELOX_MASTER_URL   Master base URL (default: http://127.0.0.1:8000)
  VELOX_ADMIN_TOKEN  Admin bearer token
  TOKEN_FILE         File containing VELOX_ADMIN_TOKEN=<value>
  FLEETCTL_GO_BIN    Go fleetctl binary override
EOF
}

die() {
    printf 'fleetctl: %s\n' "$*" >&2
    exit 2
}

resolve_token() {
    if [[ -n "${VELOX_ADMIN_TOKEN:-}" ]]; then
        printf '%s' "$VELOX_ADMIN_TOKEN"
        return
    fi
    if [[ -n "${TOKEN_FILE:-}" && -r "$TOKEN_FILE" ]]; then
        local token
        token="$(sed -n 's/^VELOX_ADMIN_TOKEN=//p' "$TOKEN_FILE" | head -n 1 \
            | tr -d '\r' | sed "s/^['\"]//; s/['\"]$//")"
        [[ -n "$token" ]] || die "TOKEN_FILE does not contain VELOX_ADMIN_TOKEN"
        printf '%s' "$token"
        return
    fi
    die 'VELOX_ADMIN_TOKEN or TOKEN_FILE is required'
}

resolve_go_fleetctl() {
    local candidate="${FLEETCTL_GO_BIN:-$ROOT/DataServer/bin/fleetctl}"
    [[ -x "$candidate" ]] || die "Go fleetctl binary not found: $candidate (set FLEETCTL_GO_BIN or build DataServer/cmd/fleetctl)"
    printf '%s' "$candidate"
}

exec_go_fleetctl() {
    local binary resolved_token
    binary="$(resolve_go_fleetctl)"
    export VELOX_MASTER_URL="$MASTER_URL"
    if [[ -z "${VELOX_ADMIN_TOKEN:-}" ]]; then
        resolved_token="$(resolve_token)"
        [[ -n "$resolved_token" ]] || die 'resolved admin token is empty'
        export VELOX_ADMIN_TOKEN="$resolved_token"
    fi
    exec "$binary" "$@" --master="$MASTER_URL"
}

exec_legacy_fleetctl() {
    [[ -x "$LEGACY" ]] || die "legacy fleetctl bridge not found: $LEGACY"
    export VELOX_MASTER_URL="$MASTER_URL"
    exec "$LEGACY" "$@"
}

command=${1:-help}
if [[ "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
    usage
    exit 0
fi

# These commands have a complete typed Go implementation. Keep the shell
# boundary limited to auth/URL compatibility and the historical drain/resume
# positional reason translation.
case "$command" in
    update|rollback|operations|wait-ready|rollout|inspect|smoke|doctor)
        exec_go_fleetctl "$@"
        ;;
    status)
        if [[ "${2:-}" == "--json" ]]; then
            exec_go_fleetctl "$@"
        fi
        exec_legacy_fleetctl "$@"
        ;;
    drain|resume)
        delegated_args=("$@")
        if [[ $# -ge 3 && "$3" != --* ]]; then
            delegated_args=("$1" "$2" --reason "$3")
        fi
        exec_go_fleetctl "${delegated_args[@]}"
        ;;
    job)
        case "${2:-}" in
            inspect|metrics|watch)
                exec_go_fleetctl "$@"
                ;;
            *)
                exec_legacy_fleetctl "$@"
                ;;
        esac
        ;;
    *)
        exec_legacy_fleetctl "$@"
        ;;
esac
