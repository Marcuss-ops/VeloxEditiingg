# Remote-worker certification environment.
# Copy to a local, untracked file and chmod 600 if it contains a token.
# Do not commit real tokens, worker addresses, or production digests.

# Master REST base URL. MASTER_URL takes precedence over VELOX_MASTER_URL.
MASTER_URL=https://master.example.com
# VELOX_MASTER_URL=https://master.example.com
MASTER_HOST=master.example.com
# Optional expected DNS result, e.g. 203.0.113.10.
# MASTER_EXPECTED_IP=203.0.113.10

# Worker identity and SSH target.
WORKER_ID=worker-01
WORKER_SSH_HOST=worker.example.com
WORKER_SSH_USER=root

# Control-plane ports used by the network checks.
MASTER_REST_PORT=8000
MASTER_GRPC_PORT=9000

# Admin credential: prefer TOKEN_FILE for local operator workflows.
# Keep TOKEN_FILE mode 600; the file must contain one line:
#   VELOX_ADMIN_TOKEN=...
# VELOX_ADMIN_TOKEN=CHANGE_ME
# TOKEN_FILE=/path/to/velox-admin.env

# Optional M2M bearer for job submission checks. Keep it in the same protected
# dotenv file or inject it from the operator secret store; never print it.
# VELOX_M2M_TOKEN=CHANGE_ME

# Optional immutable release references. When set, each must be
# sha256:<64 lowercase hexadecimal characters>.
# GOOD_DIGEST=sha256:CHANGE_ME
# PREVIOUS_DIGEST=sha256:CHANGE_ME
# BAD_DIGEST=sha256:CHANGE_ME

# Network check timeouts and R02 repetition count.
RW_NETWORK_TIMEOUT_S=30
RW_DNS_ATTEMPTS=3
RW_SSH_CONNECT_TIMEOUT_S=10
RW_CONNECT_TIMEOUT_S=5
RW_REST_REQUEST_TIMEOUT_S=10
RW_REST_ATTEMPTS=20
RW_REST_INTERVAL_S=1
RW_GRPC_TIMEOUT_S=5

# W01-W03 worker lifecycle checks.
RW_WORKER_HTTP_TIMEOUT_S=10
RW_WORKER_RESTART_TIMEOUT_S=30
RW_WORKER_RECONNECT_TIMEOUT_S=90
RW_WORKER_POLL_INTERVAL_S=2
RW_WORKER_RESTARTS=5
RW_WORKER_RESTART_CMD='sudo systemctl restart velox-worker.service'
RW_HEARTBEAT_SAMPLES=3
RW_HEARTBEAT_INTERVAL_S=10
RW_HEARTBEAT_MAX_AGE_S=30

# W04-W05 drain/resume lifecycle checks.
# The lifecycle mode verifies HTTP 202, operation polling, immediate DRAINING
# placement exclusion, duplicate-drain HTTP 409, fresh resume completion,
# Level D health/smoke evidence, HEALTHY state, and duplicate-resume HTTP 409.
RW_OPERATION_TIMEOUT_S=600
RW_OPERATION_POLL_INTERVAL_S=2

# P01 real Level D smoke.
# The default fixture is tests/worker-cert/fixtures/assets.json and uses
# .clips[0].asset_id. Override the asset only with a path-safe asset ID.
# RW_SMOKE_FIXTURES_FILE=./tests/worker-cert/fixtures/assets.json
# RW_SMOKE_ASSET_ID=27063c51bda8444a7b4d98ab4d9828826c9424f12cf1bbdeefe351afc3a4bd5c
# RW_SMOKE_RENDER_PLAN=real-level-d
# RW_SMOKE_VERIFY_CLEANUP=1
# --smoke-json triggers POST /api/v1/admin/workers/:worker_id/smoke,
# polls the operation, verifies Level D health/artifact evidence, and checks
# the executor's remote temporary paths are clean (best-effort filename
# comparison because the API does not expose run_id). The API currently
# exposes no separate size/SHA/READY fields for smoke_runs; successful smoke
# plus artifact_drive_id is the authoritative public evidence.

# P02-P03 job E2E and artifact verification.
# TEST_JOB_JSON=./tests/worker-cert/fixtures/job-smoke.json
# If TEST_JOB_JSON is unset, the canonical builder creates a payload from the
# worker-cert assets fixture. An explicit destination is mandatory.
# RW_JOB_FIXTURES_FILE=./tests/worker-cert/fixtures/assets.json
# RW_JOB_DESTINATION_ID=drive-certification
RW_JOB_SCENES_COUNT=2
RW_JOB_DURATION_PER_SCENE=3
RW_JOB_POLL_INTERVAL_S=2
RW_JOB_HTTP_TIMEOUT_S=30
RW_JOB_ARTIFACT_DOWNLOAD_TIMEOUT_S=60
# The job status endpoint currently exposes artifact_url/size opportunistically
# and not artifact_id in its documented four-field envelope. Set one of these
# when the deployment does not expose a usable artifact URL after SUCCEEDED.
# RW_JOB_ARTIFACT_ID=artifact-...
# RW_JOB_ARTIFACT_DOWNLOAD_URL=/api/internal/artifacts/artifact-.../download
# Optional expected final SHA-256 (lowercase hex, without sha256: prefix).
# If omitted, P03 always computes and validates the downloaded file's SHA-256
# format; a response-provided .artifact.sha256 is compared automatically.
# RW_JOB_EXPECTED_SHA256=...
# The pre-READY probe runs immediately after 202 only when an artifact ID/URL
# is already observable; otherwise it emits SKIP with an API observability note.
RW_JOB_PRE_READY_REQUIRED=1
RW_JOB_VERIFY_PRE_READY=1
RW_JOB_VERIFY_FFPROBE=1
RW_JOB_VERIFY_SHA256=1
# --job-json triggers P02 submit/poll and P03 admin artifact download.

# Optional local fixture and polling budget.
CERT_POLL_TIMEOUT_S=300
