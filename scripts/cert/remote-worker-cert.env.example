# Remote-worker certification environment.
# Copy to a local, untracked file and chmod 600 if it contains a token.
# Do not commit real tokens, worker addresses, or production digests.

# Master REST base URL. MASTER_URL takes precedence over VELOX_MASTER_URL.
MASTER_URL=https://master.example.com
# VELOX_MASTER_URL=https://master.example.com
MASTER_HOST=master.example.com
# Optional expected DNS result, e.g. 203.0.113.10.
# MASTER_EXPECTED_IP=203.0.113.10

# Worker identity and SSH target.
WORKER_ID=worker-01
WORKER_SSH_HOST=worker.example.com
WORKER_SSH_USER=root

# Control-plane ports used by the network checks.
MASTER_REST_PORT=8000
MASTER_GRPC_PORT=9000

# Admin credential: prefer TOKEN_FILE for local operator workflows.
# Keep TOKEN_FILE mode 600; the file must contain one line:
#   VELOX_ADMIN_TOKEN=...
# VELOX_ADMIN_TOKEN=CHANGE_ME
# TOKEN_FILE=/path/to/velox-admin.env

# Optional M2M bearer for job submission checks. Keep it in the same protected
# dotenv file or inject it from the operator secret store; never print it.
# VELOX_M2M_TOKEN=CHANGE_ME

# Optional immutable release references. When set, each must be
# sha256:<64 lowercase hexadecimal characters>.
# GOOD_DIGEST=sha256:CHANGE_ME
# PREVIOUS_DIGEST=sha256:CHANGE_ME
# BAD_DIGEST=sha256:CHANGE_ME

# Network check timeouts and R02 repetition count.
RW_NETWORK_TIMEOUT_S=30
RW_DNS_ATTEMPTS=3
RW_SSH_CONNECT_TIMEOUT_S=10
RW_CONNECT_TIMEOUT_S=5
RW_REST_REQUEST_TIMEOUT_S=10
RW_REST_ATTEMPTS=20
RW_REST_INTERVAL_S=1
RW_GRPC_TIMEOUT_S=5

# Optional local fixture and polling budget.
# TEST_JOB_JSON=./tests/worker-cert/fixtures/remote-worker-smoke.json
CERT_POLL_TIMEOUT_S=300
