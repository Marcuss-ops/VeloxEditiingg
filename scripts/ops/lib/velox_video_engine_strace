#!/bin/sh
#
# velox_video_engine_strace — strace -f -c wrapper for the native render engine.
#
# Installed (host) and bind-mounted into the worker container by
# scripts/ops/install-worker-perf-wrappers.sh. When the worker agent execs
# this wrapper as its VELOX_VIDEO_ENGINE_CPP_BIN, ONE engine invocation is
# traced with `strace -f -c` (process-lifecycle summary: execve/clone/wait4/
# read/write counts + time) — the key evidence for the Phase-0 diagnosis.
#
#   - resolves the real engine: VELOX_VIDEO_ENGINE_REAL, else
#     /usr/local/bin/velox_video_engine (in-container), else
#     /opt/velox/bin/velox_video_engine (host)
#   - writes OUT_DIR/strace-<stamp>.txt (default OUT_DIR=/var/lib/velox/perf)
#   - execs `strace -f -c` so every /bin/sh, ffprobe and ffmpeg child is
#     counted, matching the engine_ffprobe_execs / process_forks evidence
#     produced by scripts/benchmarks/native-render-baseline.sh
set -eu

REAL="${VELOX_VIDEO_ENGINE_REAL:-}"
if [ -z "$REAL" ]; then
  if [ -x /usr/local/bin/velox_video_engine ]; then
    REAL=/usr/local/bin/velox_video_engine
  elif [ -x /opt/velox/bin/velox_video_engine ]; then
    REAL=/opt/velox/bin/velox_video_engine
  else
    echo "velox_video_engine_strace: cannot locate the real engine (set VELOX_VIDEO_ENGINE_REAL)" >&2
    exit 127
  fi
fi

OUT_DIR="${VELOX_PERF_OUT_DIR:-/var/lib/velox/perf}"
mkdir -p "$OUT_DIR" 2>/dev/null || true
STAMP="$(date +%Y%m%d-%H%M%S)-$$"
OUT="$OUT_DIR/strace-${STAMP}.txt"

exec strace -f -c -S time -o "$OUT" "$REAL" "$@"
