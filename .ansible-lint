# ansible-lint configuration (shared by CI + local runs).
#
# The vault-bound operator playbooks (bootstrap-ssh.yml, fleet-*.yml)
# load `group_vars/vault.yml`, which is Ansible-Vault-encrypted. CI has
# no vault password, so `ansible-playbook --syntax-check` cannot decrypt
# the file and ansible-lint reports internal-error for every such
# playbook. Those playbooks are validated with the real vault during
# operator use (deploy-production.sh + `--ask-vault-pass`); excluding
# them from the lint pass is the only way to keep lint green in CI
# without shipping a vault password to GitHub Actions.
#
# The remaining operator playbooks (fleet-logs.yml, fleet-restart.yml,
# rollout-worker-digest.yml, rollback.yml, deploy-master-config.yml)
# stay fully linted — new rule violations there fail CI.
exclude_paths:
  - deploy/playbooks/bootstrap-ssh.yml
  - deploy/playbooks/fleet-checklist.yml
  - deploy/playbooks/fleet-drain.yml
  - deploy/playbooks/fleet-health.yml
  - deploy/playbooks/fleet-rollback.yml
  - deploy/playbooks/fleet-smoke.yml
  - deploy/playbooks/fleet-status.yml
  - deploy/playbooks/fleet-update.yml
