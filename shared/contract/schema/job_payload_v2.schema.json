{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "velox.contract.job-payload-v2",
  "title": "JobPayloadV2",
  "description": "Canonical top-level shape for a process_video job payload at the enqueue boundary. This schema is the authoritative registry of field NAMES (single source of truth); semantic validation stays in shared/contract (CanonicalTopLevelKeys, ValidatePayload) and rendermanifest/deliveryplan. The top-level key set MUST stay in lock-step with contract.CanonicalTopLevelKeys — the contractgen parity pin fails generation on drift. Drift keys (skip_creator, fit, …) are tolerated by the enqueue preflight, so additionalProperties is true.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "contract_version": { "type": "integer" },
    "payload_contract_version": { "type": "integer" },
    "job_id": { "type": "string" },
    "job_run_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "job_type": { "type": "string" },
    "template_id": { "type": "string" },
    "template_version": { "type": "integer" },
    "version": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "video_name": { "type": "string" },
    "script_text": { "type": "string" },
    "render_manifest": { "type": "object" },
    "manifest_ref": { "type": "object" },
    "manifest_sha256": { "type": "string" },
    "render_plan_json": { "type": "string" },
    "render_plan_sha256": { "type": "string" },
    "compiled_render_plan_json": { "type": "string" },
    "compiled_render_plan_sha256": { "type": "string" },
    "scenes_json": { "type": "string" },
    "scenes": { "type": "array" },
    "voiceover_paths": { "type": "array" },
    "layers": { "type": "array" },
    "items": { "type": "array" },
    "video_metadata": { "type": "object" },
    "audio_language_for_srt": { "type": "string" },
    "video_mode": { "type": "string" },
    "effect": { "type": "string" },
    "orientation": { "type": "string" },
    "output_path": { "type": "string" },
    "drive_output_folder": { "type": "string" },
    "channel_id": { "type": "string" },
    "output_video_id": { "type": "string" },
    "scene_image_paths": { "type": "array" },
    "image_source_map": { "type": "string" },
    "priority": { "type": "integer" },
    "timeout_secs": { "type": "integer" },
    "scene_count": { "type": "integer" },
    "voiceover_count": { "type": "integer" },
    "total_duration_secs": { "type": "number" },
    "scene_duration_secs": { "type": "number" },
    "submitted_via": { "type": "string" },
    "source": { "type": "string" },
    "job_fingerprint": { "type": "string" },
    "status": { "type": "string" },
    "delivery_plan": { "type": ["array", "object"] }
  },
  "required": [
    "contract_version",
    "payload_contract_version",
    "job_id",
    "job_run_id",
    "correlation_id",
    "job_type",
    "version",
    "created_at",
    "updated_at",
    "video_name",
    "script_text",
    "priority",
    "timeout_secs"
  ]
}
