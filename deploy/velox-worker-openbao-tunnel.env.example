# Copy one file per worker to ~/.config/velox/worker-openbao/<worker_id>.env
# and chmod 600. SSH key/agent authentication is required; no password.
VELOX_WORKER_SSH_HOST=CHANGE_ME
VELOX_WORKER_SSH_USER=CHANGE_ME
VELOX_WORKER_SSH_PORT=22
VELOX_WORKER_OPENBAO_PORT=8200
VELOX_TUNNEL_OPENBAO_PORT=18200
VELOX_WORKER_OPENBAO_CA_FILE=/etc/velox-worker/certs/openbao-ca.crt
VELOX_WORKER_OPENBAO_PROBE_SCRIPT=/usr/local/bin/probe-worker-openbao.sh
