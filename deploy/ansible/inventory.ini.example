# Velox — bootstrap/seed inventory template.
#
# This is the only repository inventory template. Copy it to the local
# deploy/ansible/inventory.ini, fill in connection data, and keep that file
# local. After bootstrap, the Master WorkerNodeRegistry (SQLite ansible_hosts)
# is the runtime source of truth; this file is only the provisioning/seed
# input for velox-admin sync-worker-nodes.
#
# Do not put worker credentials in this file. See
# docs/operations/credential-registry.md.

[velox_workers]
velox-worker-1 ansible_host=CHANGE_ME_PUBLIC_IP ansible_user=pierone worker_id=velox-worker-1
velox-worker-2 ansible_host=CHANGE_ME_PUBLIC_IP ansible_user=pierone worker_id=velox-worker-2

[velox_workers:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file=~/.ssh/id_ed25519_velox
ansible_ssh_common_args=-o StrictHostKeyChecking=accept-new
