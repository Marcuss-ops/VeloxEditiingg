# Velox Worker — canonical environment template.
# ─────────────────────────────────────────────────────────────────────────────
# Copy to /etc/velox-worker/worker.env on the host and edit. This file lives
# at the same canonical path on every worker host.
#
# Variables here are read by both prepare-host.sh (image/version resolution)
# and the running worker container (env_file). Changes take effect on the
# next `systemctl restart velox-worker.service` on the host.
#
# The worker_id MUST match:
#   * the worker_id registered in the Master WorkerNodeRegistry
#     (`ansible_hosts` DB table — the canonical connectivity source).
#   * The VELOX_ALLOWED_WORKERS comma-separated list materialized in
#     /etc/velox-server.env by deploy/openbao/scripts/resolve-master-env.sh.
# Mismatches gate the worker out of the fleet silently.

# ── Image identity (REQUIRED) ─────────────────────────────────────────────────────
# Reference MUST be a pinned @sha256:<64 hex> digest. The deploy-time gate
# in deploy/runtime/prepare-host.sh rejects :latest or any other non-digest
# form.
#
#   1. The worker-image workflow publishes a digest to GHCR for every
#      pushed tag (worker-v*) and every merged PR (sha-<short>).
#   2. Copy the digest from the workflow's image-digest artifact OR from
#      the GHCR package page.
#   3. Paste it below — the placeholder below is intentionally all-zeros so
#      deploy/runtime/prepare-host.sh loudly refuses to start the worker.
VELOX_WORKER_IMAGE=ghcr.io/marcuss-ops/velox-worker@sha256:REPLACE_ME_WITH_REAL_DIGEST_FROM_WORKFLOW_OUTPUT

# Optional operator metadata surfaced in the Master WorkerCard heartbeat.
# The image digest itself is derived from VELOX_WORKER_IMAGE above.
VELOX_DESIRED_VERSION=
VELOX_DEPLOYMENT_STATE=CURRENT

# ── Identity ──────────────────────────────────────────────────────────────────────
VELOX_WORKER_ID=velox-worker-1

# ── Master connectivity ─────────────────────────────────────────────────────
# Public host:port of the master's gRPC control plane.
# Use a reachable public IP or DNS name. For the current fleet:
# CHANGE_ME_MASTER_HOST:9000
VELOX_GRPC_MASTER_URL=CHANGE_ME_MASTER_HOST:9000

# REST base URL of the master (scheme + host + REST port). The compose
# `-master` flag passes this value to the worker binary's master_url config
# (an http(s) URL, NOT the gRPC host:port above — see compose.yml).
# REQUIRED: both prepare-host.sh and `docker compose config` fail loudly
# when this variable is missing.
VELOX_MASTER_URL=http://CHANGE_ME_MASTER_HOST:8000

# ── Credential injection (read-only mounts at /run/velox/secrets) ────────
# prepare-host.sh binds /etc/velox-worker/secrets → /run/velox/secrets (ro).
VELOX_WORKER_CREDENTIAL_FILE=/run/velox/secrets/worker_credential

# ── OpenBao credential + PKI enrollment (OPZIONALE durante la migrazione) ──
# Se VELOX_OPENBAO_ADDR è valorizzato, prepare-host.sh legge worker_credential
# da KV e usa la PKI OpenBao per firmare un CSR generato localmente. La private
# key non viene mai inviata o salvata in OpenBao. In production configurata,
# l'assenza/fallimento di OpenBao è fail-closed: non esiste fallback a cert/key
# copiati manualmente. Lasciare VELOX_OPENBAO_ADDR vuoto solo per host legacy.
#
# Durante la fase transitoria OpenBao è esposto solo su loopback del master:
# punta qui a un tunnel SSH (es. ssh -L 8200:127.0.0.1:8200 master) o, quando
# sarà esposta, all'URL pubblica del listener.
# VELOX_OPENBAO_ADDR=https://127.0.0.1:8200
#
# Materiale AppRole del worker (role-id + secret-id, 0600, MAI in repo):
# VELOX_OPENBAO_ROLE_ID_FILE=/etc/velox-worker/secrets/approle/role-id
# VELOX_OPENBAO_SECRET_ID_FILE=/etc/velox-worker/secrets/approle/secret-id
#
# Certificato pubblico di trust TLS di OpenBao (obbligatorio quando
# VELOX_OPENBAO_ADDR è impostato; il fetch usa curl --cacert e fallisce
# se il file manca):
# VELOX_OPENBAO_CA_FILE=/etc/velox-worker/certs/openbao-ca.crt
# Optional PKI controls:
# VELOX_OPENBAO_PKI_MOUNT=pki
# VELOX_OPENBAO_PKI_ROLE=worker-${VELOX_WORKER_ID}
# VELOX_OPENBAO_PKI_TTL=168h
# VELOX_MTLS_RENEW_BEFORE_SECONDS=172800

# TLS for the gRPC link (cert files mounted from /etc/velox-worker/certs).
VELOX_GRPC_TLS_CERT_FILE=/run/velox/certs/worker.crt
VELOX_GRPC_TLS_KEY_FILE=/run/velox/certs/worker.key
VELOX_GRPC_TLS_CA_FILE=/run/velox/certs/ca.crt

# ── Workload configuration ───────────────────────────────────────────────────
# Rendering backend. Keep `native` for the existing Velox C++ engine; set this
# to `chronon` only when VELOX_WORKER_IMAGE points to the Chronon runtime image.
# Chronon is invoked through its canonical `render-plan` CLI surface.
VELOX_RENDER_BACKEND=native
# Required only with the Chronon worker image. The image supplied by
# Dockerfile.chronon already provides this path.
# CHRONON3D_CLI=/opt/chronon3d/bin/chronon3d_cli

# Canonical mutable-state root (REQUIRED; no default is permitted).
# This host path is bind-mounted to /var/lib/velox-worker in the container.
# Existing owner, mode, ACLs, and contents are preserved by the convergers.
VELOX_STATE_DIR=/var/lib/velox-worker

# Work directory inside the container. Keep it below VELOX_STATE_DIR.
VELOX_WORK_DIR=/var/lib/velox-worker/work

# Maximum number of jobs this worker accepts in parallel.
# The configured value (when > 0) ALWAYS takes precedence over hardware
# detection (NumCPU/2). Setting this to 1 guarantees exactly one concurrent
# job, regardless of CPU count. Set to 0 to auto-detect from hardware.
VELOX_MAX_ACTIVE_JOBS=1

# Health endpoint port — must match the compose.yml healthcheck AND the
# ports: binding that exposes /health/ready to the host loopback.
VELOX_HEALTH_PORT=8081

# Cache directory inside the container. The compose filesystem root is
# read-only (deploy/runtime/compose.yml); without this override the worker
# tries to write to /home/velox/.cache and the first ffmpeg/ffprobe call
# fails. /var/lib/velox-worker is bind-mounted read-write from the host.
XDG_CACHE_HOME=/var/lib/velox-worker/cache

# ── Operationally-tunable extras (uncomment if needed) ───────────────────
# GIN_MODE=release
# LOG_LEVEL=info
# TZ=UTC
