---
# Velox — SECRET group variables (operator-populated, ansible-vault encrypted).
# ────────────────────────────────────────────────────────────────────────────
# This file is committed ONLY as a placeholder. The real vault file MUST be
# created locally and encrypted with `ansible-vault` before use:
#
#   1. cp deploy/group_vars/vault.yml.example deploy/group_vars/vault.yml
#   2. $EDITOR deploy/group_vars/vault.yml   # fill in real values
#   3. ansible-vault encrypt deploy/group_vars/vault.yml
#
# Decryption requires a vault password. Provide via one of:
#   --ask-vault-pass                              (interactive)
#   --vault-password-file ~/.vault-velox          (file; perms 0600)
#   $ANSIBLE_VAULT_PASSWORD                       (env var; for CI Secrets)
#
# Git hygiene:
#   * The plain-text form (`vault.yml`, no `.example` suffix) is NOT
#     committed. Add `deploy/group_vars/vault.yml` to your `.gitignore`.
#   * The encrypted form IS safe to commit so CI can decrypt at runtime.
#
# ⚠️ MIGRAZIONE OpenBao (fase 6): i token del master ora vivono nel KV OpenBao
#    velox/production/master/* (+ services/registry/*) e il deploy li risolve
#    con deploy/openbao/scripts/resolve-master-tokens.sh (AppRole), iniettandoli
#    come extra-vars che VINCONO su group_vars. I valori sotto sono il FALLBACK
#    legacy durante la transizione: i nomi NON cambiano (velox-server.env.j2 li
#    consuma identici), cambia solo la provenienza. Quando la migrazione sarà
#    completa, questi campi possono restare vuoti.

# ── Master REST API token (consumed by velox-server.env.j2) ─────────────────
# Fallback legacy: OpenBao velox/production/master/admin-token
vault_velox_admin_token: ""

# ── InstaEdit Control JWT secret (consumed by velox-server.env.j2) ─────────
# HS256 shared secret verifying InstaEdit BFF's short-lived JWTs.
# MUST be at least 32 bytes (256 bits). Distinct from SOCIAL_API_TOKEN.
# Fallback legacy: OpenBao velox/production/master/instaedit-control-jwt-secret
vault_velox_instaedit_control_jwt_secret: ""

# ── External Social API secrets (consumed by velox-server.env.j2) ──────────
# Both render directly into the active env file; operator / install
# preflight verifies the rendered values are non-empty if a publish
# destination is configured. These keys are the ONLY Social-API
# secrets Velox owns; do not introduce `VELOX_YOUTUBE_*` or similar
# pre-removal naming here.
# Fallback legacy: OpenBao velox/production/master/social-api-token +
# velox/production/master/social-webhook-secret
vault_velox_social_api_token: ""        # → SOCIAL_API_TOKEN (canonical)
vault_velox_social_webhook_secret: ""   # → SOCIAL_WEBHOOK_SECRET (future-proof)

# ── Container registry pull credentials (used by worker image runtime) ──────
# Fallback legacy: OpenBao velox/production/services/registry/{username,token}
vault_velox_registry_username: ""
vault_velox_registry_token: ""

# ── Per-worker secrets minted at install time (one entry per worker) ────────
# MUST be sourced from a secrets manager (1Password, Bitwarden, Vault, etc.)
#
# Mapping to a host happens in the inventory: set `worker_secret` on the
# [velox_workers] line, e.g.
#   worker_57_129 ansible_host=... worker_id=... worker_secret={{ vault_velox_worker_credential_1 }}
# canonical_worker_runtime.yml renders `worker_secret` into the canonical
# EnvironmentFile (/etc/velox-worker-<host>.env, mode 0600) as
# VELOX_WORKER_SECRET. A vault-supplied value wins over any secret preserved
# from legacy env files. The deploy FAILS BEFORE RESTART if the env file
# would end up without a non-empty VELOX_WORKER_SECRET while the master
# already holds a stored credential for that worker_id.
vault_velox_worker_credential_1: ""
vault_velox_worker_credential_2: ""
vault_velox_worker_credential_3: ""

# ── Optional: operator SSH public key (consumed by bootstrap-ssh.yml) ───────
# When set, bootstrap-ssh.yml reads it here instead of requiring the operator
# to pass --extra-vars on every invocation.
vault_velox_operator_pubkey: ""

# ── OpenBao SSH CA public key (consumed by bootstrap-ssh.yml) ────────────────
# ⚠️ MIGRAZIONE SSH CA (fase 7): la chiave PUBBLICA della CA SSH di OpenBao
#    (deploy/openbao/scripts/provision-ssh-ca.sh → .velox/openbao/ssh-ca.pub).
#    Copiata su /etc/ssh/trusted-user-ca-keys.pem e dichiarata
#    TrustedUserCAKeys: i nodi accettano i certificati firmati da OpenBao
#    (TTL breve, principals velox-admin/velox-deploy). È PUBBLICA (non un
#    segreto) — sta qui solo per comodità del playbook. Quando TUTTI gli
#    operatori useranno i cert, si potrà rimuovere vault_velox_operator_pubkey
#    e il task authorized_keys di bootstrap-ssh.yml.
vault_velox_ssh_ca_pubkey: ""
