# deploy/openbao/.env — docker compose environment (TEMPLATE, tracked).
# ─────────────────────────────────────────────────────────────────────────────
# Copy to deploy/openbao/.env (gitignored — see deploy/openbao/.gitignore and
# the root `.env` rules) and adjust before `docker compose up -d`.
#
# Only non-secret configuration lives here. Unseal keys, root token and TLS
# material are NEVER configured here: they are generated by the bootstrap
# scripts into the gitignored state dir `<repo>/.velox/openbao/` (mode 0600).

# OpenBao image reference (must remain pinned by @sha256).
OPENBAO_IMAGE=openbao/openbao:2.6.1@sha256:5b2486ab0fb90bbc788cc345b0a08616dfb375873ee8be5df3a2fd4d378a67e0

# Host port where the API listener is published (bound to 127.0.0.1 only).
OPENBAO_HOST_PORT=8200

# Directory holding server.crt + server.key for the TLS listener, generated
# by scripts/gen-tls.sh. Path is relative to deploy/openbao/ (compose file dir):
# the default ../../.velox/openbao/tls resolves to the gitignored
# `<repo>/.velox/openbao/tls` (NOT infra/.velox — two levels up!).
OPENBAO_TLS_DIR=../../.velox/openbao/tls
